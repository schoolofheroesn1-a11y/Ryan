# Скопируйте этот файл в .env (команда: cp deploy/env.example .env) и заполните.
# Пароли: только латинские буквы и цифры. Сгенерировать: openssl rand -hex 24

# Пароль базы данных (придумайте длинный, его не нужно помнить)
POSTGRES_PASSWORD=замените-на-случайную-строку

# Адрес сайта, как его будут открывать люди
APP_URL=https://pedlab.ru

# Для Caddy: ваш домен без https:// (например pedlab.ru), он получит HTTPS автоматически.
# Пока домена нет — напишите :80 и откройте сайт по http://IP-сервера
SITE_ADDRESS=pedlab.ru

# Учётная запись администратора, создаётся при первом запуске
SEED_ADMIN_EMAIL=admin@pedlab.ru
SEED_ADMIN_PASSWORD=замените-на-надёжный-пароль

# true — добавить демонстрационные материалы (удобно посмотреть сайт), false — пустой сайт
SEED_DEMO=false
