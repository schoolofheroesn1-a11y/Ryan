# Подключение к PostgreSQL 14+ (нужен словарь 'russian' для полнотекстового поиска — есть в стандартной поставке)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedlab"

# Публичный адрес сайта: используется в sitemap.xml, robots.txt и метаданных
APP_URL="http://localhost:3000"

# Каталог для вложений (вне public/). На сервере укажите постоянный том.
UPLOAD_DIR="./storage/uploads"

# Учётная запись администратора, создаваемая командой npm run db:seed.
# ОБЯЗАТЕЛЬНО задайте свой пароль перед публичным запуском.
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-me-to-a-long-random-password"

# false — не создавать демонстрационные материалы и демо-аккаунты
SEED_DEMO="true"

# Базы для автоматических тестов (имена должны оканчиваться на _test и _e2e — они пересоздаются)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedlab_test"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedlab_e2e"
