# Ash & Iron на обычном хостинге (Apache): HTTPS, типы файлов игры, сжатие и кэш.
# Камера в браузере работает только по HTTPS, поэтому все запросы переводятся на https://.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # технические адреса sweb (*.swtest.ru) открываются без перевода на https — для проверки
  RewriteCond %{HTTP_HOST} !swtest\.ru$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www.ash-a-iron.com -> ash-a-iron.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Без этих типов браузер не запустит распознавание движений (wasm и модуль .mjs)
AddType application/wasm .wasm
AddType text/javascript .mjs .js
AddType application/manifest+json .webmanifest
AddType application/octet-stream .task
AddType font/woff2 .woff2

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/wasm
</IfModule>

<IfModule mod_headers.c>
  # sw.js и страница всегда свежие — так игроки сразу получают обновления
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(wasm|task|woff2|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
