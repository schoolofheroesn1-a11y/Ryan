# Ash & Iron на обычном хостинге (Apache): HTTPS, типы файлов игры, сжатие и кэш.
# Перевод на https:// не здесь: на sweb перед Apache стоит nginx, и правило в .htaccess зацикливается.
# Включайте перенаправление на HTTPS в панели хостинга после выпуска SSL-сертификата.
DirectoryIndex index.html
Options -Indexes

# Без этих типов браузер не запустит распознавание движений (wasm и модуль .mjs)
AddType application/wasm .wasm
AddType text/javascript .mjs .js
AddType application/manifest+json .webmanifest
AddType application/octet-stream .task
AddType font/woff2 .woff2

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/wasm
</IfModule>

<IfModule mod_headers.c>
  # страница, скрипты, стили и данные всегда сверяются с сервером — обновления доходят сразу
  # (no-cache: браузер хранит копию, но перед использованием спрашивает, не изменился ли файл)
  <FilesMatch "\.(html|js|mjs|css|json|webmanifest|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(wasm|task|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# пароль базы, список кодов и пароли Robokassa не отдаются наружу
<IfModule mod_authz_host.c>
  <FilesMatch "^(lb_config|codes|robokassa_config)\.php$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
