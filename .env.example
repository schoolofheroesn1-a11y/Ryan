# ===== Сервер =====
PORT=3000
# Папка для базы данных и загруженных файлов
DATA_DIR=./data

# Для сайта на https (coach-sl.ru) — cookie только по защищённому соединению
COOKIE_SECURE=false

# ===== ИИ: Claude (Anthropic) — используется в первую очередь, если задан ключ =====
# Ключ выглядит как sk-ant-api03-...  Получить: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Прокси для запросов к ИИ (если API недоступен из страны, где стоит сервер).
# Пример: http://user:pass@1.2.3.4:3128
AI_PROXY=

# ===== ИИ: любой OpenAI-совместимый API (если нет ключа Claude) =====
# Если AI_API_KEY пустой — используется встроенный анализ по правилам (без нейросети).
#
# OpenAI (ChatGPT):
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4.1-mini
# Kimi (Moonshot AI):
#   AI_BASE_URL=https://api.moonshot.ai/v1
#   AI_MODEL=kimi-k2-0905-preview
# DeepSeek:
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
# OpenRouter (есть бесплатные модели с суффиксом :free):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=deepseek/deepseek-chat-v3-0324:free
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
